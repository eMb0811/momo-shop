# ==============================================================================
# momoShop - Production Environment Variables
# ==============================================================================

# Nom de domaine public pointant vers votre VPS (ex: DuckDNS ou domaine personnalisé)
# - Pour DuckDNS : momoshop.duckdns.org
# - Pour tester en local : localhost
DOMAIN=momoshop.duckdns.org

# Adresse email pour l'enregistrement du certificat SSL automatique Let's Encrypt
ACME_EMAIL=contact@momoshop.sn

# ==============================================================================
# Monitoring, Sécurité Admin & Alertes Temps Réel
# ==============================================================================

# Mot de passe d'accès au dashboard /monitoring (à personnaliser impérativement en production)
MONITORING_PASSWORD=changez-moi-mot-de-passe-solide

# URL de Webhook optionnelle pour recevoir les alertes (Discord, Slack, Telegram ou Webhook JSON)
# Déclenché en cas de : commande WhatsApp, stock critique/épuisé, erreur applicative ou dégradation santé
ALERT_WEBHOOK_URL=
